# Copy to `.env` for local overrides (and set the same names in the Vercel project settings
# for production). `.env` is gitignored; this file is the template and holds no secrets.

# Origin of the POS backend that serves /api/v1/shop/* and /media/*, with no trailing slash.
# Leave EMPTY in local development: `npm run dev` forwards /api and /media to
# http://127.0.0.1:8000 (astro.config.mjs). In production it is REQUIRED unless /api and
# /media are served from the same origin as the site (for example a Vercel rewrite):
# without it the order page asks its own domain and shows "Menu unavailable (404)".
# It is read at BUILD time, so redeploy after changing it.
# Example: PUBLIC_API_BASE_URL=https://api.example.com
PUBLIC_API_BASE_URL=

# Local development only: where the dev server forwards /api and /media.
# API_PROXY_TARGET=http://127.0.0.1:8000
