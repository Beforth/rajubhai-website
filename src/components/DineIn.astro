<section class="section book-wrap">
  <div class="container book-grid">
    <div data-reveal>
      <h2 class="section-title">You're always welcome here.</h2>
      <p class="section-sub" style="margin-bottom:36px;">Come sit with us for the full Rajubhai experience — fresh Dabeli, warm hospitality, and three decades of flavour, served hot.</p>
      <a href="#contact" class="btn btn-primary">Contact Us<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
    </div>
    <!-- data-reveal sits on the wrapper, not .book-card itself — the reveal system's
         "in-view" state resets transform, which would fight the card's own static tilt
         (see design.md Motion — a real bug found in review, same fix as the Hero photo). -->
    <div data-reveal>
      <div class="book-card">
        <h3>Opening Hours</h3>
        <div class="book-row"><div class="left"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Monday – Thursday</div><span>1:00 – 9:00 PM</span></div>
        <div class="book-row"><div class="left"><svg class="icon" aria-hidden="true"><use href="#i-clock"/></svg>Friday – Sunday</div><span>1:00 – 9:00 PM</span></div>
        <div class="book-row"><div class="left"><svg class="icon" aria-hidden="true"><use href="#i-mail"/></svg>Email</div><span>devesh.jobanputra@gmail.com</span></div>
        <a href="mailto:devesh.jobanputra@gmail.com" class="btn btn-outline">Email Us</a>
      </div>
    </div>
  </div>
</section>
