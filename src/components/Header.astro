---
interface Props {
  showCall?: boolean;
}
const { showCall = true } = Astro.props;
---
<header>
  <div class="nav-wrap container">
    <a href="/" class="logo">
      <div class="crest crest-logo"><img src="/logo.png" alt="Rajubhai Dabeliwale" width="96" height="96" /></div>
      <div class="logo-name">Rajubhai Dabeliwale<small>Est. 1987 · Nashik</small></div>
    </a>
    <nav class="nav-links" id="navLinks">
      <a href="/#home">Home</a>
      <a href="/#about">About</a>
      <a href="/#menu">Menu</a>
      <a href="/#gallery">Gallery</a>
      <a href="/#reviews">Reviews</a>
      <a href="/#contact">Contact</a>
    </nav>
    <div class="nav-cta">
      <a href="/order" class="btn btn-primary btn-sm">Order<span class="btn-label-ext"> Online</span></a>
      {showCall && <a href="tel:+919168169991" class="btn btn-outline btn-sm" aria-label="Call to order">Call<span class="btn-label-ext"> to Order</span><svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg></a>}
      <button class="hamburger" id="hamburger" aria-label="Toggle navigation" aria-expanded="false" aria-controls="navLinks"><span></span><span></span><span></span></button>
    </div>
  </div>
</header>
