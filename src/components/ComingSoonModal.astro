---
const PHONE = "+919168169991";
const MAPS_URL = "https://maps.app.goo.gl/qKiXufxYfqKcgbWy9";
---
<div class="modal-overlay" id="comingSoonOverlay" aria-hidden="true">
  <div class="modal-card" role="dialog" aria-modal="true" aria-labelledby="comingSoonTitle" aria-describedby="comingSoonDesc">
    <button type="button" class="modal-close" id="comingSoonClose" aria-label="Close">
      <svg class="icon" aria-hidden="true"><use href="#i-close"/></svg>
    </button>
    <div class="modal-icon"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true"><use href="#i-dabeli"/></svg></div>
    <div class="tag center" style="justify-content:center;">Coming Soon</div>
    <h3 id="comingSoonTitle">Online ordering is on its way</h3>
    <p id="comingSoonDesc">We're putting the finishing touches on online ordering. Until then, call ahead or walk in — your Dabeli's hot and ready either way.</p>
    <div class="modal-actions">
      <a href={`tel:${PHONE}`} class="btn btn-primary">Call Us<svg class="icon" aria-hidden="true"><use href="#i-phone"/></svg></a>
      <a href={MAPS_URL} class="btn btn-outline" target="_blank" rel="noopener">Get Directions</a>
    </div>
  </div>
</div>
