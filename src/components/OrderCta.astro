---
const ORDER_URL = "https://rajubhaidabeliwale.com/onlineorder/";
---
<section class="order-cta">
  <div class="inner container">
    <div class="tag on-dark tag-plain center" style="justify-content:center;">Order Online</div>
    <h2>Hot, fresh &amp; <em style="color:var(--gold)">on its way</em></h2>
    <p>Rajesh Gokuldas Jobanputra started Rajubhai Dabeliwale in Nashik back in 1987 — now your favourite Dabeli is a few taps away.</p>
    <a href={ORDER_URL} class="btn btn-cream" target="_blank" rel="noopener">Order Now<svg class="icon" aria-hidden="true"><use href="#i-arrow"/></svg></a>
  </div>
</section>
